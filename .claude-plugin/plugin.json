{
  "name": "cavemax",
  "description": "Make AI coding agents brutally concise: strips filler and repetition while preserving code, errors, identifiers, paths, commands and security warnings. Glyph notation, abbreviation dictionary, telegraphic syntax.",
  "version": "0.1.0",
  "author": {
    "name": "Nixus-security",
    "url": "https://github.com/Nixus-security/Cavemax-Skills"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/cavemax-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading cavemax mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/cavemax-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking cavemax mode..."
          }
        ]
      }
    ]
  }
}
